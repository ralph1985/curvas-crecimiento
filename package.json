{
  "name": "curvas-crecimiento",
  "version": "0.1.0",
  "description": "Aplicación web para crear curvas de crecimiento infantil de la OMS",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "start": "webpack serve --mode=development --host 127.0.0.1 --port 8081",
    "watch": "webpack --watch --mode=development",
    "build": "webpack build --mode=production",
    "test": "tsx node_modules/ospec/bin/ospec test/**/*.spec.ts --preload test/test-setup.ts",
    "lint": "biome check",
    "compile": "tsc",
    "fix": "biome check --fix",
    "pretest": "pnpm run compile"
  },
  "keywords": [],
  "author": "Frederik Leonhardt <frederik.leonhardt@gmail.com>",
  "contributors": [
    {
      "name": "Rafael García Prieto"
    }
  ],
  "license": "ISC",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@js-joda/core": "6.0.1",
    "chartist": "1.5.0",
    "mithril": "2.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/jsdom": "21.1.7",
    "@types/mithril": "2.2.8",
    "@types/node": "24.12.2",
    "@types/ospec": "4.2.0",
    "css-loader": "6.11.0",
    "html-webpack-plugin": "5.6.7",
    "jsdom": "24.1.3",
    "mini-css-extract-plugin": "2.10.2",
    "mithril-query": "4.0.1",
    "ospec": "4.2.1",
    "sass": "1.99.0",
    "sass-loader": "14.2.1",
    "style-loader": "3.3.4",
    "ts-loader": "9.5.7",
    "tsx": "4.22.4",
    "typescript": "5.6.3",
    "webpack": "5.106.2",
    "webpack-cli": "7.0.2",
    "webpack-dev-server": "5.2.6"
  }
}
